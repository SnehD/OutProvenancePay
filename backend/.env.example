# Copy to backend/.env and fill in. Never commit backend/.env.
OPP_DATA_DIR=./data
OPP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PayPal Sandbox (empty => "setup required")
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional external AI provider (empty => labelled deterministic fallback)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

OPP_FRONTEND_URL=http://localhost:5173
